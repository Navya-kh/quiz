<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Quiz</title>
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
              * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body, html {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            background-color: #f4f4f4;
        }
        .question {
            display: none;
            width: 100%;
        }
        .active {
            display: block;
        }
        button {
            display: block;
            margin: 10px auto;
            padding: 10px;
            width: 100%;
            font-size: 18px;
            background-color:#91a8cf;
        }
        .np-buttons {
            display: flex;
            justify-content: space-between; 
            margin-top: 10px;
            gap: 300px;
            margin-top: 60px;
            width:33%;
        }   
       .np-buttons button {
    padding: 12px 24px;
    font-size: 16px;
    border: none;
    cursor: pointer;
    color: white;
    border-radius: 5px;
    
}

.np-buttons button:first-child {
    background-color: #007BFF;
}

.np-buttons button:last-child {
    background-color: #28A745;
}
    </style>
</head>
<body>
  
    <div id="quiz-container">
        <div class="question active" data-q="1">
            <h2>1. What does HTML stand for?</h2>
            <button>Hyper text preprocessor</button>
            <button>Hyper text markup language</button>
            <button>Hyper text multiple language</button>
            <button>Hyper tool multi language</button>
            <div class="np-buttons">
                <button class="next" data-next="2">Next</button>
            </div>
        </div>
        
        <div class="question" data-q="2">
            <h2>2. Which language runs in a web browser?</h2>
            <button>Java</button>
            <button>Python</button>
            <button>JavaScript</button>
            <button>C</button>
            <div class="np-buttons">
                <button class="prev" data-prev="1">Previous</button>
                <button class="next" data-next="3">Next</button>
            </div>
        </div>
        
        <div class="question" data-q="3">
            <h2>3. What does W3C stand for?</h2>
            <button>World Web Wide</button>
            <button>Wide World Web</button>
            <button>World Wide Web</button>
            <button>World Wide Web Control</button>
            <div class="np-buttons">
                <button class="prev" data-prev="2">Previous</button>
                <button class="next" data-next="4">Next</button>
            </div>
        </div>
        
        <div class="question" data-q="4">
            <h2>4. An HTML document is saved using:</h2>
            <button>.htl</button>
            <button>.html</button>
            <button>.hml</button>
            <button>.ht</button>
            <div class="np-buttons">
                <button class="prev" data-prev="3">Previous</button>
                <button class="next" data-next="5">Next</button>
            </div>
        </div>
        
        <div class="question" data-q="5">
            <h2>5. What does CSS stand for?</h2>
            <button>Cascading Style Sheet</button>
            <button>Cascade Style Sheet</button>
            <button>Color Style Sheet</button>
            <button>Cascade Sheets Style</button>
            <div class="np-buttons">
                <button class="prev" data-prev="4">Previous</button>
                <button id="submit">Submit</button>
            </div>
        </div>
        
        <h3 id="score"></h3>
    </div>

    <script>
        let score = 0;
        const correctAnswers = {
            1: "Hyper text markup language",
            2: "JavaScript",
            3: "World Wide Web",
            4: ".html",
            5: "Cascading Style Sheet"
        };
        
        $(document).ready(function() {
            $('.question button').click(function() {
                let questionNum = $(this).parent().data('q');
                let selectedAnswer = $(this).text();
                $(this).css({ 'background': 'green', 'color': 'white' });
                
                if (selectedAnswer === correctAnswers[questionNum]) {
                    score++;
                }
            });

            $('.next').click(function() {
                let next = $(this).data('next');
                $('.question').removeClass('active');
                $(`.question[data-q="${next}"]`).addClass('active');
            });

            $('.prev').click(function() {
                let prev = $(this).data('prev');
                $('.question').removeClass('active');
                $(`.question[data-q="${prev}"]`).addClass('active');
            });
            
            $('#submit').click(function() {
                $('#score').text(`Your score: ${score}/5`);
                alert(`Quiz submitted! Your score: ${score}/5`);
            });
        });
    </script>
</body>
</html>
